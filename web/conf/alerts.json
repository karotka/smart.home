{
  "_comment": "Alert rules, evaluated in the background by checkerd via alerts.py. Edit thresholds here; changes apply live (mtime-reloaded, no restart). Each rule: scope per_pack iterates BMS packs. conditions are ANDed. hold_s = condition must persist this long before the alert fires. Message placeholders: {pack_id} {value} {threshold} {unit}. Packs are 14S LiPo: cell full ~4200 mV, empty ~3000 mV; overvolt alerts above normal full (4250), undervolt below safe (3000).",
  "rules": [
    {
      "id": "batt_soc_low", "name": "SOC nízké", "category": "battery",
      "severity": "warning", "enabled": true, "scope": "per_pack", "hold_s": 60,
      "unit": "%", "conditions": [{"field": "soc", "op": "<", "threshold": 20}],
      "message": "Pack {pack_id}: SOC {value} % pod {threshold} %"
    },
    {
      "id": "batt_soc_critical", "name": "SOC kriticky nízké", "category": "battery",
      "severity": "critical", "enabled": true, "scope": "per_pack", "hold_s": 30,
      "unit": "%", "conditions": [{"field": "soc", "op": "<", "threshold": 10}],
      "message": "Pack {pack_id}: SOC {value} % kriticky pod {threshold} %"
    },
    {
      "id": "batt_delta_warn", "name": "Nevyváženost článků", "category": "battery",
      "severity": "warning", "enabled": true, "scope": "per_pack", "hold_s": 120,
      "unit": "mV", "conditions": [{"field": "cell_delta_mv", "op": ">", "threshold": 50}],
      "message": "Pack {pack_id}: rozdíl článků {value} mV nad {threshold} mV"
    },
    {
      "id": "batt_delta_crit", "name": "Silná nevyváženost článků", "category": "battery",
      "severity": "critical", "enabled": true, "scope": "per_pack", "hold_s": 60,
      "unit": "mV", "conditions": [{"field": "cell_delta_mv", "op": ">", "threshold": 100}],
      "message": "Pack {pack_id}: rozdíl článků {value} mV nad {threshold} mV"
    },
    {
      "id": "batt_cell_overvolt", "name": "Přepětí článku", "category": "battery",
      "severity": "critical", "enabled": true, "scope": "per_pack", "hold_s": 10,
      "unit": "mV", "conditions": [{"field": "cell_max_mv", "op": ">", "threshold": 4250}],
      "message": "Pack {pack_id}: nejvyšší článek {value} mV nad {threshold} mV"
    },
    {
      "id": "batt_cell_undervolt", "name": "Podpětí článku", "category": "battery",
      "severity": "critical", "enabled": true, "scope": "per_pack", "hold_s": 10,
      "unit": "mV", "conditions": [{"field": "cell_min_mv", "op": "<", "threshold": 3000}],
      "message": "Pack {pack_id}: nejnižší článek {value} mV pod {threshold} mV"
    },
    {
      "id": "batt_temp_high", "name": "Vysoká teplota baterie", "category": "battery",
      "severity": "critical", "enabled": true, "scope": "per_pack", "hold_s": 30,
      "unit": "°C", "conditions": [{"field": "temp_max_c", "op": ">", "threshold": 45}],
      "message": "Pack {pack_id}: teplota {value} °C nad {threshold} °C"
    },
    {
      "id": "batt_charge_frost", "name": "Nabíjení při mrazu", "category": "battery",
      "severity": "critical", "enabled": true, "scope": "per_pack", "hold_s": 20,
      "unit": "°C", "conditions": [
        {"field": "temp_min_c", "op": "<", "threshold": 2},
        {"field": "charging", "op": "==", "threshold": 1}
      ],
      "message": "Pack {pack_id}: nabíjení při {value} °C (mráz poškozuje články)"
    },
    {
      "id": "batt_offline", "name": "Pack offline", "category": "battery",
      "severity": "warning", "enabled": true, "scope": "per_pack", "hold_s": 0,
      "unit": "s", "conditions": [{"field": "age_s", "op": ">", "threshold": 60}],
      "message": "Pack {pack_id}: bez dat {value} s"
    }
  ]
}
