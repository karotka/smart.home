[Unit]
Description=Hourly solar forecast refresh

[Timer]
# Open-Meteo updates its model runs a few times a day, so hourly is already
# generous — but the fitted factor and the actuals overlay move continuously
# through the day, which is the real reason to re-run this often.
OnBootSec=3min
OnUnitActiveSec=1h
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
