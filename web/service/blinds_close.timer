[Unit]
Description=Blinds — 22:00 close trigger

[Timer]
# Local time (host is Europe/Prague), so it follows the DST change with
# the clock on the wall, which is what "ten at night" means to a person.
OnCalendar=*-*-* 22:00:00
AccuracySec=30s
# Persistent is deliberately OFF, and this is the one setting here worth
# arguing about. With it on, a host that was down at 22:00 fires the
# missed run the moment it boots — which, after a daytime power cut, means
# the living room shutting itself at two in the afternoon. A blind is not
# a backup job: a schedule it missed is better skipped than caught up.
Persistent=false

[Install]
WantedBy=timers.target
